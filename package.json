{
  "name": "pptr-helper",
  "version": "0.0.4",
  "type": "module",
  "description": "Deterministic webpage rendering for screenshots, PDFs, and extraction with Puppeteer.",
  "keywords": [
    "puppeteer",
    "screenshot",
    "pdf",
    "browser-automation",
    "web-rendering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsafight/pptr-helper.git"
  },
  "bugs": {
    "url": "https://github.com/wsafight/pptr-helper/issues"
  },
  "homepage": "https://github.com/wsafight/pptr-helper#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "MIGRATION.md",
    "README.md",
    "README.EN.md",
    "scripts/install-browser.mjs",
    "skills"
  ],
  "bin": {
    "pptr-helper": "./bin/pptr-helper.mjs"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "prepare": "rslib build && husky",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "browser:install": "pnpm build && node scripts/install-browser.mjs",
    "cli": "pnpm build && node bin/pptr-helper.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:cli",
    "clean": "rimraf dist",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "change": "changeset",
    "bump": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm check",
    "test": "pnpm build && vitest run",
    "test:browser": "pnpm build && vitest run --no-file-parallelism tests/renderer.integration.test.ts tests/cli.integration.test.ts",
    "test:cli": "pnpm build && vitest run tests/cli.test.ts",
    "test:unit": "vitest run tests/index.test.ts tests/task-queue.test.ts tests/task-signal.test.ts tests/browser-manager.test.ts tests/network.test.ts tests/observability.test.ts tests/pool.test.ts tests/presets.test.ts tests/scheduler.test.ts tests/visual.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tests/tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,mjsx,cjs,cjsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.1",
    "ajv": "^8.20.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "25.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@rslib/core": "0.23.2",
    "@types/node": "24.13.3",
    "@types/pngjs": "^6.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.24.0"
}
